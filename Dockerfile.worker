FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY services/api/package.json services/api/package.json
RUN npm ci
COPY services/api services/api
RUN npm --workspace services/api run db:generate && npm --workspace services/api run build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
COPY services/api/package.json services/api/package.json
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/node_modules/.prisma /app/node_modules/.prisma
COPY --from=build /app/node_modules/@prisma /app/node_modules/@prisma
COPY --from=build /app/services/api/dist /app/services/api/dist
COPY --from=build /app/services/api/prisma /app/services/api/prisma
USER node
CMD ["node","services/api/dist/src/worker.js"]
